# Chat completion provider (OpenAI-compatible)
CHAT_BASE_URL=https://your-openai-compatible-provider.example/v1
CHAT_API_KEY=replace-me
CHAT_MODEL=replace-me

# Embedding provider (OpenAI-compatible)
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_API_KEY=replace-me
EMBEDDING_MODEL=text-embedding-v4

# Application
LAWAGENT_DATA_DIR=./data
LAWAGENT_CORPUS_DIR=./RAG
LAWAGENT_OFFLINE_MODE=false
LAWAGENT_ADMIN_API_KEY=replace-with-a-separate-admin-key
LAWAGENT_MAX_RETRIES=2
LAWAGENT_MAX_TOOL_CALLS=12
LAWAGENT_MAX_INPUT_CHARS=6000
LAWAGENT_MODEL_TIMEOUT_SECONDS=18
